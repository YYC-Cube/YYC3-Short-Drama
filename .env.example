# YYC3-Short-Drama 环境变量模板
# 使用方法: cp .env.example .env.local 并填入真实值
# 安全规则: .env.local 已被 .gitignore 排除，严禁提交任何真实密钥到版本库
# 适用范围: 静态导出模式（默认）无需任何环境变量；以下仅全栈模式需要

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3030

# JWT 密钥（必填，至少 32 字符）
# 生成命令: openssl rand -base64 48
JWT_SECRET=

# AI 服务配置（AI 编剧功能，全栈模式）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# 监控配置（可选，静态模式同样生效）
# 配置后客户端自动启用 Sentry 错误上报与 Web Vitals 劣化告警；
# 留空则完全关闭（SDK 不加载、零网络开销）。DSN 为公开值，可安全用于浏览器端。
NEXT_PUBLIC_SENTRY_DSN=

# 数据库配置（MySQL）
# 注意: 用户名与密码必填，代码不再提供默认凭据回退（2026-10-05 安全整改）
DB_MASTER_HOST=localhost
DB_MASTER_PORT=3306
DB_MASTER_USER=
DB_MASTER_PASS=
DB_MASTER_NAME=yyc3_my
